{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:4b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (host, Metal)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "Qwen3 4B (host Ollama)"
        }
      }
    }
  },
  "mcp": {
    "macaulay2": {
      "type": "local",
      "command": ["uv", "--directory", "/workspace/m2-mcp", "run", "macaulay2-mcp"],
      "enabled": true
    }
  },
  "permission": {
    "*": "allow"
  }
}
